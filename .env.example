# ── TengaSell environment ─────────────────────────────────────────────
# Copy to .env for local work. Every value below has a working dev default;
# nothing here is required to boot the static demo.

# Platform (Prisma) database — the BFF plane
DATABASE_URL="file:./db/custom.db"

# Marketplace record store (Trailbase, Rust)
TRAILBASE_URL="http://localhost:3001"

# Auth / sessions
NEXTAUTH_SECRET="dev-only-change-me"
PLATFORM_JWT_SECRET="dev-only-change-me"
TGS_INTERNAL_SECRET="dev-only-change-me"
TGS_INTERNAL_TOKEN="dev-only-change-me"

# Internal services
TRUST_URL="http://localhost:3007"
COMMS_URL="http://localhost:3005"
FINANCE_URL="http://localhost:3006"
GOVERN_URL="http://localhost:3008"
GIS_BASE_URL="http://localhost:3004"

# Paynow — runs in mock mode when unset
PAYNOW_INTEGRATION_ID=""
PAYNOW_INTEGRATION_KEY=""
PAYNOW_RESULT_URL=""
PAYNOW_RETURN_URL=""

# Messaging / email (all optional in dev)
RESEND_API_KEY=""
EMAIL_FROM="no-reply@tengasell.com"
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""
WHATSAPP_APP_SECRET=""
MESSENGER_PAGE_TOKEN=""
GRAPH_API_VERSION="v20.0"
TELEGRAM_BOT_TOKEN=""

# Public origin used by robots.txt / sitemap
APP_URL="http://localhost:8080"

# Seeded staff account (demo only)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="Tengasell#2025"
