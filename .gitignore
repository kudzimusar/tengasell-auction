# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# …but the documented template must ship
!.env.example

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/

# ── TengaSell local runtime data (never commit) ──────────────
# SQLite databases, WAL/SHM sidecars and runtime flags live outside git.
/db/
/backups/
*.db
*.db-shm
*.db-wal

# Local verification / smoke artifacts
/.smoke-t5d/
/tool-results/
/Cache/
/download/

# CI helper database
/ci.db
/ci.db-journal

# Static demo build output (generated by scripts/build-static-demo.mjs)
/out/
/.static-demo-api-stash/
/static-demo-build.log

# Local env files (already covered above, kept explicit for clarity)
.env
.env.local
.env.*.local
# local tool binaries (Trailbase is downloaded, never committed)
/.tools/
*.zip
