{
  "name": "TengaSell — Zimbabwe's Online Auction Marketplace",
  "short_name": "TengaSell",
  "description": "Bid, buy and sell in Zimbabwe's online auction marketplace. Live auctions, escrow-style buyer protection and Paynow checkout.",
  "id": "/",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#19717B",
