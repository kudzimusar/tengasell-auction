    name: "vehicle_documents"
    table_name: "vehicle_documents"
    acl_authenticated: [CREATE, READ, UPDATE]
    create_access_rule: "EXISTS(SELECT 1 FROM _user WHERE id = _USER_.id AND admin = TRUE)"
    read_access_rule: "EXISTS(SELECT 1 FROM _user WHERE id = _USER_.id AND admin = TRUE)"
    update_access_rule: "EXISTS(SELECT 1 FROM _user WHERE id = _USER_.id AND admin = TRUE)"
    delete_access_rule: "EXISTS(SELECT 1 FROM _user WHERE id = _USER_.id AND admin = TRUE)"
  },
  {
    # IMP-04: vehicle/inspection authority is server mediated through the
    # canonical trade engine. Direct browser records access is forbidden.
    name: "vehicle_staff_roles"
    table_name: "vehicle_staff_roles"
    acl_authenticated: [CREATE, READ, UPDATE, DELETE]
    create_access_rule: "EXISTS(SELECT 1 FROM _user WHERE id = _USER_.id AND admin = TRUE)"
    read_access_rule: "EXISTS(SELECT 1 FROM _user WHERE id = _USER_.id AND admin = TRUE)"
    update_access_rule: "EXISTS(SELECT 1 FROM _user WHERE id = _USER_.id AND admin = TRUE)"
    delete_access_rule: "EXISTS(SELECT 1 FROM _user WHERE id = _USER_.id AND admin = TRUE)"
  },
