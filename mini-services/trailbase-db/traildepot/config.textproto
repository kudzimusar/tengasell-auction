    name: "auction_lots"
    table_name: "auction_lots"
    acl_world: [READ]
    acl_authenticated: [CREATE, READ, UPDATE]
    create_access_rule: "EXISTS(SELECT 1 FROM _user WHERE id = _USER_.id AND admin = TRUE)"
    update_access_rule: "EXISTS(SELECT 1 FROM _user WHERE id = _USER_.id AND admin = TRUE)"
    delete_access_rule: "EXISTS(SELECT 1 FROM _user WHERE id = _USER_.id AND admin = TRUE)"
  },
  {
    # Private durable command ledger for optimistic concurrency and stale
    # operator rejection.
    name: "run_list_commands"
    table_name: "run_list_commands"
    acl_authenticated: [CREATE, READ]
    create_access_rule: "EXISTS(SELECT 1 FROM _user WHERE id = _USER_.id AND admin = TRUE)"
    read_access_rule: "EXISTS(SELECT 1 FROM _user WHERE id = _USER_.id AND admin = TRUE)"
  },
  {
    # IMP-06 commercial authority is server mediated. The trade engine uses
    # its admin token and returns only actor-scoped qualification summaries.
    name: "auction_bidder_qualifications"
    table_name: "auction_bidder_qualifications"
    acl_authenticated: [CREATE, READ, UPDATE]
    create_access_rule: "EXISTS(SELECT 1 FROM _user WHERE id = _USER_.id AND admin = TRUE)"
    read_access_rule: "EXISTS(SELECT 1 FROM _user WHERE id = _USER_.id AND admin = TRUE)"
    update_access_rule: "EXISTS(SELECT 1 FROM _user WHERE id = _USER_.id AND admin = TRUE)"
